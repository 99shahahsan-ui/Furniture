<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ahsan's Furniture</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}body{font-family:Arial,sans-serif;background:#0f0f12;color:#fff;overflow-x:hidden}section{padding:60px 6%}.hero{height:100vh;background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.7)),url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1600&q=80') center/cover;display:flex;align-items:center;justify-content:center;text-align:center;position:relative}.lamp{width:8px;height:140px;background:#333;position:absolute;top:0;left:50%}.bulb{width:70px;height:70px;border-radius:50%;background:#ffd86b;box-shadow:0 0 60px #ffd86b;position:absolute;top:135px;left:calc(50% - 35px);transition:.8s}.off{opacity:.15;box-shadow:none}.hero h1{font-size:4rem}.btn{display:inline-block;margin-top:25px;padding:14px 28px;background:#c8a96b;color:#111;text-decoration:none;border-radius:30px;font-weight:bold}.hidden{display:none}.nav{position:sticky;top:0;background:#111a;padding:15px 6%;backdrop-filter:blur(8px)}.nav a{color:#fff;margin-right:18px;text-decoration:none}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px}.card{background:#1a1a22;border-radius:18px;overflow:hidden;transform:translateY(30px);opacity:0;transition:1s}.card.show{transform:translateY(0);opacity:1}.img{height:180px;background-size:cover;background-position:center}.card .p{padding:18px}.price{color:#c8a96b;font-size:1.2rem;font-weight:bold;margin-top:8px}.footer{text-align:center;padding:40px;color:#bbb}
</style>
</head>
<body>
<div id='landing' class='hero'>
<div class='lamp'></div><div id='bulb' class='bulb'></div>
<div><h1>Ahsan's Furniture</h1><p>Luxury • Modern • Timeless • Custom Designs</p><a href='#' class='btn' onclick='enterSite()'>Visit Now</a></div>
</div>
<div id='main' class='hidden'>
<div class='nav'><a href='#sofas'>Sofas</a><a href='#beds'>Beds</a><a href='#contact'>Contact</a></div>
<section><h2>Welcome</h2><p>Discover premium furniture crafted for elegant living, with designer sofas, modern beds, and custom-made luxury interiors.</p></section>
<section id='sofas'><h2>Luxury Sofas • Full Collection</h2><div class='grid'>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Italian Sowe Sofa</h3><div class='price'>$450</div></div></div>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1493663284031-b7e3aefcae8e?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Classic Italia</h3><div class='price'>$459</div></div></div>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Classic American Sofa</h3><div class='price'>$200</div></div></div>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1501045661006-fcebe0257c3f?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Italian Dome</h3><div class='price'>$600</div></div></div>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1519947486511-46149fa0a254?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Spanish King Sofa</h3><div class='price'>$330</div></div></div>
</div></section>
<section id='beds'><h2>Modern Beds • Full Collection</h2><div class='grid'>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Wooden Single Person Bed</h3><div class='price'>$790</div></div></div>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Single Bed</h3><div class='price'>$360</div></div></div>
<div class='card'><div class='img' style="background-image:url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80')"></div><div class='p'><h3>Single Bed Persian</h3><div class='price'>$690</div></div></div>
</div></section>
<section id='contact'><h2>Contact & Orders</h2><p>Call or WhatsApp us for custom orders and delivery.</p><p style='margin-top:12px;font-size:1.4rem;color:#c8a96b;font-weight:bold'>01946097351</p><p style='margin-top:18px'><a class='btn' target='_blank' href='https://wa.me/8801946097351'>Order on WhatsApp</a></p></section><div class='footer'>New arrivals added: Classic Bridge Sofa, Mashed Blue Sofa, Borge American Sofa, Single Hei Bed, Single Bed Set [2]. © 2026 Ahsan's Furniture • Crafted for Elegant Living</div>
</div>
<script>
function enterSite(){document.getElementById('bulb').classList.add('off');setTimeout(()=>{document.getElementById('landing').style.display='none';document.getElementById('main').classList.remove('hidden');reveal();window.scrollTo(0,0)},900)}
function reveal(){document.querySelectorAll('.card').forEach((c,i)=>setTimeout(()=>c.classList.add('show'),i*150));}
window.addEventListener('scroll',()=>{document.querySelectorAll('.card').forEach(card=>{if(card.getBoundingClientRect().top<window.innerHeight-80)card.classList.add('show')})})
</script>
</body>
</html>
